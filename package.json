{
  "name": "antbox-hrms-stabilization",
  "version": "1.0.0",
  "description": "Production stabilization trial — safe multi-system sync, resilient background jobs, and fail-closed deploy controls for AntBox HRMS.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "preflight": "tsx scripts/preflight.ts",
    "preflight:built": "node dist/scripts/preflight.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "start": "node dist/src/index.js",
    "predeploy": "npm run build && npm run preflight:built",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "hrms",
    "reliability",
    "idempotency",
    "background-jobs",
    "data-safety"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
