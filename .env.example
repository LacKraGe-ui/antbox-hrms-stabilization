# Copy to .env for local runs. The preflight check FAILS CLOSED if any
# required variable below is missing, so a misconfigured deploy halts
# before it can touch production data.

# --- Required ---
NODE_ENV=development
PORT=3000

# Path to the SQLite database file (the system of record).
DATABASE_URL=./data/hrms.db

# Mock external sync target. In a real deploy this would be a Google
# Sheets service-account or a webhook URL; here it is simulated.
SYNC_TARGET_URL=mock://google-sheets

# --- Optional (sensible defaults applied if unset) ---
# Max attempts before a job is moved to the dead-letter state.
JOB_MAX_ATTEMPTS=5
# Base delay (ms) for exponential backoff between retries.
JOB_BACKOFF_BASE_MS=200
# Worker poll interval (ms).
WORKER_POLL_MS=250
